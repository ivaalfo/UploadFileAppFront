{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "",
    "outDir": "dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "module": "esnext",
    "moduleResolution": "node",
    "importHelpers": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "target": "es2015",
    "strict": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      "@fileTransfer/shared": [
        "dist/fileTransfer/shared"
      ],
      "@fileTransfer/shared/*": [
        "dist/fileTransfer/shared/*"
      ]
    }
  },
  "angularCompilerOptions": {
    "fullTemplateTypeCheck": true,
    "strictInjectionParameters": true
  }
}
