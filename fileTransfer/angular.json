{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@fileTransfer/shared": {
      "projectType": "library",
      "root": "projects/fileTransfer/shared",
      "sourceRoot": "projects/fileTransfer/shared/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-ng-packagr:build",
          "options": {
            "tsConfig": "projects/fileTransfer/shared/tsconfig.lib.json",
            "project": "projects/fileTransfer/shared/ng-package.json"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/fileTransfer/shared/src/test.ts",
            "tsConfig": "projects/fileTransfer/shared/tsconfig.spec.json",
            "karmaConfig": "projects/fileTransfer/shared/karma.conf.js"
          }
        },
        "lint": {
          "builder": "@angular-devkit/build-angular:tslint",
          "options": {
            "tsConfig": [
              "projects/fileTransfer/shared/tsconfig.lib.json",
              "projects/fileTransfer/shared/tsconfig.spec.json"
            ],
            "exclude": [
              "**/node_modules/**"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "84b8b9ed-40a5-4a55-a8a7-70f6427f39b7"
  }
}
